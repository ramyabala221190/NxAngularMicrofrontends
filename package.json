{
  "name": "@my-shopping-app/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "local-start": "npx nx serve shell --devRemotes=products,carts",
    "shell-build": "npx nx build shell",
    "products-build": "npx nx build products",
    "carts-build": "npx nx build carts",
    "docker-compose-build": "docker compose -f docker/docker-compose.yml build",
    "docker-compose-up": "docker compose -f docker/docker-compose.yml up -d --remove-orphans --no-build",
    "docker-shell-build": "docker build -t shell-app:4 -f apps/shell/Dockerfile .",
    "docker-carts-build": "docker build -t carts-app:4 -f apps/carts/Dockerfile .",
    "docker-products-build": "docker build -t products-app:4 -f apps/products/Dockerfile .",
    "docker-shell-run": "docker run -d -p 4200:4200 --name running-shell-app shell-app:1",
    "docker-carts-run": "docker run -d -p 4202:4202 --name running-carts-app carts-app:2",
    "docker-products-run": "docker run -d -p 4201:4201 --name running-products-app products-app:2"
  },
  "private": true,
  "devDependencies": {
    "@angular-devkit/build-angular": "~22.1.0",
    "@angular-devkit/core": "~22.1.0",
    "@angular-devkit/schematics": "~22.1.0",
    "@angular/cli": "~22.1.0",
    "@angular/compiler-cli": "~22.1.0",
    "@angular/language-service": "~22.1.0",
    "@eslint/js": "^9.8.0",
    "@module-federation/enhanced": "^2.1.0",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/module-federation": "23.2.1",
    "@nx/web": "23.2.1",
    "@nx/webpack": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@schematics/angular": "~22.1.0",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.20",
    "@swc/helpers": "~0.5.18",
    "@typescript-eslint/utils": "^8.58.0",
    "angular-eslint": "^22.1.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "nx": "23.2.1",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "webpack-merge": "^5.8.0"
  },
  "dependencies": {
    "@angular/common": "~22.1.0",
    "@angular/compiler": "~22.1.0",
    "@angular/core": "~22.1.0",
    "@angular/forms": "~22.1.0",
    "@angular/platform-browser": "~22.1.0",
    "@angular/router": "~22.1.0",
    "@nx/angular": "^23.2.1",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "jquery": "^4.0.0",
    "rxjs": "~7.8.0"
  }
}
