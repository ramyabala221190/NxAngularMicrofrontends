
    server{
    listen 0.0.0.0:${APP_PORT};
    listen [::]:${APP_PORT};
    default_type application/octet-stream;
    error_log /var/log/nginx/error.log debug;

    types {
        application/javascript js mjs;
        application/json json;
        text/css css;
        text/html html;
    }

    gzip                    on;
    gzip_comp_level         6;
    gzip_vary               on;
    gzip_min_length         1000;
    gzip_proxied            any;
    gzip_types              text/plain text/css application/json application/x-javascript text/xml application/xml application/xml+rss text/javascript;
    gzip_buffers            16 8k;
    client_max_body_size    256M;

    root /usr/share/nginx/html/${CONTAINER_APP_NAME}/;

    location /assets/ {
        autoindex off;  # Prevents exposing raw directory contents
    }

    location / {
        # Clean SPA fallback: serves file/dir if found, otherwise routes to index.html with 200 OK
        try_files $uri $uri/ /index.html;
    }

    }
