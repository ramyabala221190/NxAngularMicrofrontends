
    server{
    listen 0.0.0.0:${NGINX_PORT};
    default_type application/octet-stream;
    error_log /var/log/nginx/error.log debug;

    # 🛠️ CRITICAL: Explicitly map modern JS modules so they aren't served as octet-stream
    types {
        text/html                             html htm shtml;
        text/css                              css;
        application/javascript                js mjs;
        application/json                      json;
    }

   # 🛠️ GLOBAL PROXY DEFAULTS (Inherited by all locations)
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection 'upgrade';
    proxy_set_header Host $host;
    proxy_cache_bypass $http_upgrade;

    # 🛠️ EXPAND PROCESSING BUFFERS (Fixed size relationship)
    proxy_buffer_size 64k;
    proxy_buffers 8 64k;         # Total pool = 512k, individual buffer >= header buffer
    proxy_busy_buffers_size 128k;
    
    # EXTEND NETWORK TIMEOUT THRESHOLDS
    proxy_connect_timeout 600s;
    proxy_send_timeout 600s;
    proxy_read_timeout 600s;
    send_timeout 600s;

    gzip                    on;
    gzip_comp_level         6;
    gzip_vary               on;
    gzip_min_length         1000;
    gzip_proxied            any;
    gzip_types              text/plain text/css application/json application/x-javascript text/xml application/xml application/xml+rss text/javascript;
    gzip_buffers            16 8k;
    client_max_body_size    256M;


    location /products/ {
        proxy_pass http://products-app:${APP_PORT}/;
    }

    location /carts/ {
        proxy_pass http://carts-app:${APP_PORT}/;
    }

    location / {
        proxy_pass http://shell-app:${APP_PORT}/;
    }
}

